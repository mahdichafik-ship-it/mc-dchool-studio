modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
PHOTO_UPLOAD_KEY = "Where do I get the value for PHOTO_UPLOAD_KEY? Which service is this key for?\""

[userenv.shared]
PLATFORM_OWNER_USER_ID = "user_3Ge4DiJPRJjUvoMhPndYHElcq7L"
R2_ACCOUNT_ID = "62121efc6269739f71f1bd7e8490c7d8"
R2_BUCKET_NAME = "volume-capture-private"
R2_REGION = "auto"

[nix]
channel = "stable-25_05"
