modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pre-photo-day-card-rehearsal"

[[workflows.workflow]]
name = "pre-photo-day-card-rehearsal"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:launch-rehearsal-130"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[userenv]

[userenv.development]
PHOTO_UPLOAD_KEY = "Where do I get the value for PHOTO_UPLOAD_KEY? Which service is this key for?\""

[userenv.shared]
PLATFORM_OWNER_USER_ID = "user_3Ge4DiJPRJjUvoMhPndYHElcq7L"
R2_ACCOUNT_ID = "62121efc6269739f71f1bd7e8490c7d8"
R2_BUCKET_NAME = "volume-capture-private"
R2_REGION = "auto"
RESEND_FROM_EMAIL = "Volume Capture <onboarding@resend.dev>"
PUBLIC_APP_URL = "https://volumecapture.net"

[nix]
channel = "stable-25_05"
