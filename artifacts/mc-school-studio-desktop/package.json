{
  "name": "@workspace/mc-school-studio-desktop",
  "version": "1.0.85",
  "private": true,
  "description": "Desktop photo capture and matching app for school photo days",
  "author": "Volume Capture",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:naming": "node --experimental-strip-types --test test/photo-file-naming.test.ts",
    "test:qr-marker": "node --experimental-strip-types --test test/qr-marker.test.ts",
    "test:qr": "node --experimental-strip-types --test test/qr-reader.test.ts",
    "test:sequence": "node --experimental-strip-types --test test/photo-sequence.test.ts",
    "test:offline-flow": "node --experimental-strip-types --test test/offline-capture-flow.test.ts",
    "test:watcher": "node --experimental-strip-types --test test/watcher-photo-processing.test.ts",
    "test:upload-retry": "node --experimental-strip-types --test test/upload-retry-schedule.test.ts",
    "test:upload-concurrency": "node --experimental-strip-types --test test/upload-concurrency.test.ts",
    "test:upload-response-validation": "node --experimental-strip-types --test test/upload-response-validation.test.ts",
    "test:upload-transfer-timeout": "node --experimental-strip-types --test test/upload-transfer-timeout.test.ts",
    "test:capture-upload-export": "node --experimental-loader ./test/resolve-ts-loader.mjs --experimental-strip-types --test test/capture-upload-export.test.ts",
    "test:pixieset": "node --experimental-loader ./test/resolve-ts-loader.mjs --experimental-strip-types --test test/pixieset-export.test.ts",
    "test:project-sync": "node --experimental-loader ./test/resolve-ts-loader.mjs --experimental-strip-types --test test/project-sync.test.ts",
    "test:project-scale": "node --experimental-strip-types --test test/project-roster-scale.test.ts",
    "test:roster-shortcuts": "node --experimental-strip-types --test test/roster-shortcuts.test.ts",
    "test:live-preview": "node --experimental-strip-types --test test/live-preview.test.ts",
    "test:blank-portrait": "node --experimental-strip-types --test test/blank-portrait.test.ts",
    "test:review-status": "node --experimental-strip-types --test test/capture-review-status.test.ts",
    "test:shoot-layout": "pnpm run build && node --experimental-strip-types --test test/shoot-workspace-layout.test.ts && node test/shoot-workspace-rendered-layout.mjs",
    "benchmark:image-ingestion": "node --experimental-strip-types test/image-ingestion-benchmark.ts",
    "test:retirement": "node --experimental-strip-types --test test/retirement.test.ts",
    "test:retirement-copy": "node --experimental-strip-types --test test/retirement-team-copy.test.ts",
    "test:retirement-release": "node test/retirement-release-smoke.mjs",
    "test:update-release": "node test/update-release-smoke.mjs",
    "test:updater": "node --test test/updater-metadata.test.mjs",
    "test:prune-mac-native": "node --test test/prune-mac-native-dependencies.test.mjs",
    "test:db-migration": "node --experimental-strip-types --test test/database-migration.test.ts",
    "check:release-history": "node scripts/verify-release-history.mjs",
    "validate:updater": "node scripts/validate-updater-metadata.mjs",
    "prune:mac-native": "node scripts/prune-mac-native-dependencies.mjs",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:mac:x64": "pnpm run build && electron-builder --mac --x64 --publish never",
    "dist:mac:arm64": "pnpm run build && electron-builder --mac --arm64 --publish never",
    "merge:mac-updater": "node scripts/merge-mac-updater-metadata.mjs",
    "dist": "pnpm run dist:mac"
  },
  "dependencies": {
    "better-sqlite3": "12.4.6",
    "chokidar": "^4.0.3",
    "drizzle-orm": "catalog:",
    "electron-updater": "^6.8.9",
    "exiftool-vendored": "^37.2.0",
    "jimp": "^1.6.0",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "dmg-license": "1.0.11",
    "electron": "39.8.10",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.4.3"
  }
}
