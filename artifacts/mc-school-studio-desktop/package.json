{
  "name": "@workspace/mc-school-studio-desktop",
  "version": "1.0.28",
  "private": true,
  "description": "Desktop photo capture and matching app for school photo days",
  "author": "MC School Studio",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:naming": "node --experimental-strip-types --test test/photo-file-naming.test.ts",
    "test:qr-marker": "node --experimental-strip-types --test test/qr-marker.test.ts",
    "test:qr": "node --experimental-strip-types --test test/qr-reader.test.ts",
    "test:sequence": "node --experimental-strip-types --test test/photo-sequence.test.ts",
    "test:offline-flow": "node --experimental-strip-types --test test/offline-capture-flow.test.ts",
    "test:watcher": "node --experimental-strip-types --test test/watcher-photo-processing.test.ts",
    "benchmark:image-ingestion": "node --experimental-strip-types test/image-ingestion-benchmark.ts",
    "test:retirement": "node --experimental-strip-types --test test/retirement.test.ts",
    "test:retirement-copy": "node --experimental-strip-types --test test/retirement-team-copy.test.ts",
    "test:retirement-release": "node test/retirement-release-smoke.mjs",
    "test:update-release": "node test/update-release-smoke.mjs",
    "test:updater": "node --test test/updater-metadata.test.mjs",
    "test:db-migration": "node --experimental-strip-types --test test/database-migration.test.ts",
    "validate:updater": "node scripts/validate-updater-metadata.mjs",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist": "pnpm run dist:mac"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "catalog:",
    "electron-updater": "^6.8.9",
    "jimp": "^1.6.0",
    "jsqr": "^1.4.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@tailwindcss/vite": "catalog:",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vite": "^5.4.21"
  }
}
